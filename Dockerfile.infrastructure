# syntax=docker/dockerfile:1
FROM --platform=$BUILDPLATFORM node:26-bookworm-slim AS admin
WORKDIR /build
COPY --from=admin_source package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY --from=admin_source index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json postcss.config.js tailwind.config.js ./
COPY --from=admin_source src ./src
COPY --from=admin_source public ./public
RUN npm run build

FROM --platform=$BUILDPLATFORM alpine:3.22 AS themes
RUN apk add --no-cache bash ca-certificates curl unzip yq
WORKDIR /build
COPY script/fetch-frontends.sh script/
COPY cmd/dashboard/user-overlay cmd/dashboard/user-overlay/
COPY service/singleton/frontend-templates.yaml service/singleton/
RUN mkdir -p cmd/dashboard && bash script/fetch-frontends.sh && rm -rf cmd/dashboard/admin-dist cmd/dashboard/user-overlay

FROM golang:1.26.6-bookworm AS dashboard
ARG DASHBOARD_VERSION=v2.6.2-infrastructure
WORKDIR /build
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd ./cmd
COPY model ./model
COPY pkg ./pkg
COPY proto ./proto
COPY service ./service
COPY --from=themes /build/cmd/dashboard/ ./cmd/dashboard/
COPY --from=admin /build/dist/ ./cmd/dashboard/admin-dist/
RUN --mount=type=secret,id=ipinfo_token \
    if [ -s /run/secrets/ipinfo_token ]; then \
        curl --fail --silent --show-error --get \
            --data-urlencode "token=$(cat /run/secrets/ipinfo_token)" \
            --output pkg/geoip/geoip.db https://ipinfo.io/data/free/country.mmdb; \
    fi
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go run github.com/swaggo/swag/cmd/swag@v1.16.6 init --pd -d cmd/dashboard -g main.go -o cmd/dashboard/docs && \
    CGO_ENABLED=1 go build -trimpath -buildvcs=false -tags go_json \
        -ldflags "-s -w -X github.com/nezhahq/nezha/service/singleton.Version=${DASHBOARD_VERSION} -extldflags '-static -fpic'" \
        -o /out/app ./cmd/dashboard

FROM busybox:stable-musl
COPY --from=dashboard /etc/ssl/certs /etc/ssl/certs
COPY --from=dashboard /usr/share/zoneinfo /usr/share/zoneinfo
COPY script/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
WORKDIR /dashboard
COPY --from=dashboard /out/app ./app
VOLUME ["/dashboard/data"]
EXPOSE 8008
ENV TZ=Asia/Shanghai
ENTRYPOINT ["/entrypoint.sh"]
